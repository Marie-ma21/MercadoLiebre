<!-----Productos----->
  
    <article class="tarjeta">
    <img class="imagen" src="/public/img/<%= producto.imagen %>" alt="">
    <div class="caja">
        <div class="flex">
            <p><%= producto.precio %></p>
            <p><%= producto.descuento %></p>
        </div>
        <div>
            <p class="descripciones"><%= producto.descripcion %></p>
        </div>
    </div>
    <div class="detalle"><%= producto.detalle %></div>
</article> 
  